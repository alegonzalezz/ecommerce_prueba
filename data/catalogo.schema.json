{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "catalogo.schema.json",
  "title": "Catálogo de la tienda",
  "type": "object",
  "additionalProperties": false,
  "required": ["productos", "carruseles"],
  "properties": {
    "productos": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/producto" }
    },
    "carruseles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/carrusel" }
    }
  },
  "definitions": {
    "imagen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "alt"],
      "properties": {
        "src": { "type": "string", "minLength": 1 },
        "alt": { "type": "string", "minLength": 1 }
      }
    },
    "producto": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "slug", "nombre", "descripcionCorta", "descripcion",
        "precio", "precioAnterior", "moneda", "categoria", "marca", "sku",
        "stock", "etiquetas", "atributos", "fechaAlta", "activo", "imagenes"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "nombre": { "type": "string", "minLength": 1 },
        "descripcionCorta": { "type": "string", "minLength": 1 },
        "descripcion": { "type": "string", "minLength": 1 },
        "precio": { "type": "integer", "minimum": 0 },
        "precioAnterior": { "type": ["integer", "null"], "minimum": 0 },
        "moneda": { "const": "ARS" },
        "categoria": { "type": "string", "minLength": 1 },
        "marca": { "type": "string", "minLength": 1 },
        "sku": { "type": "string", "minLength": 1 },
        "stock": { "type": "integer", "minimum": 0 },
        "etiquetas": { "type": "array", "items": { "type": "string" } },
        "atributos": { "type": "object", "additionalProperties": { "type": "string" } },
        "fechaAlta": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "activo": { "type": "boolean" },
        "imagenes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["card", "mobile", "desktop"],
          "properties": {
            "card": { "$ref": "#/definitions/imagen" },
            "mobile": { "$ref": "#/definitions/imagen" },
            "desktop": { "$ref": "#/definitions/imagen" }
          }
        }
      }
    },
    "carrusel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nombre", "productos"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "nombre": { "type": "string", "minLength": 1 },
        "productos": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
