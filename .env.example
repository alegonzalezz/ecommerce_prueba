# URL pública del sitio, sin barra final. Se usa en canonical, sitemap, robots, datos estructurados y Open Graph.
# Importante: las páginas se pregeneran en el build, así que hay que definirla ANTES de `npm run build`.
NUXT_PUBLIC_SITE_URL=https://tu-dominio.com

# ---------- Mercado Pago (sandbox) ----------
# Access Token de PRUEBA de tu aplicación (panel de desarrolladores de Mercado Pago > Tus integraciones).
# Es un secreto: solo va en tu .env local o en las variables del servidor. NUNCA en el repositorio ni en el chat.
NUXT_MERCADOPAGO_ACCESS_TOKEN=

# Solo para probar contra el Mercado Pago simulado (npm run mercadopago:simulado). Dejar vacío para usar el real.
# NUXT_MERCADOPAGO_API_URL=http://localhost:3400

# Muestra "Modo de prueba: no se cobra dinero real". Poner false únicamente cuando el equipo decida pasar a producción (C-03).
NUXT_PUBLIC_MODO_PRUEBA=true

# ---------- Publicación estática en GitHub Pages (los define el workflow; ver .github/workflows/deploy-pages.yml) ----------
# NUXT_ESTATICO=true                                   # al construir: genera sitio estático sin servidor
# NUXT_APP_BASE_URL=/ecommerce_prueba/                 # subcarpeta del sitio de proyecto
# NUXT_PUBLIC_SITE_URL=https://usuario.github.io/ecommerce_prueba
# NUXT_PUBLIC_PAGO_DISPONIBLE=false                    # sin servidor no se puede pagar
